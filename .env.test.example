# Local Supabase Test Environment Example
# Copy this file to .env.test for running database integration tests (npm run test:db)
# SECURITY GUARD: Test runner will refuse to execute unless SUPABASE_URL is localhost or 127.0.0.1.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_test_anon_key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_test_service_role_key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
